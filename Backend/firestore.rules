rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidOwnerUid(userId) {
      return 'ownerUid' in request.resource.data
        && request.resource.data.ownerUid == userId;
    }

    function isValidPriority(value) {
      return value in ['LOW', 'MEDIUM', 'HIGH'];
    }

    function isValidTaskStatus(value) {
      return value in ['PENDING', 'IN_PROGRESS', 'COMPLETED'];
    }

    function isValidOptionalPhotoUrl() {
      return !('photoUrl' in request.resource.data)
        || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048
            && (request.resource.data.photoUrl == ''
                || request.resource.data.photoUrl.matches('^https://.*')));
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidOwnerUid(userId)
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && isValidOptionalPhotoUrl();
      allow update: if isOwner(userId)
        && hasValidOwnerUid(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 100))
        && (!('university' in request.resource.data)
            || (request.resource.data.university is string
                && request.resource.data.university.size() <= 150))
        && (!('course' in request.resource.data)
            || (request.resource.data.course is string
                && request.resource.data.course.size() <= 100))
        && (!('semester' in request.resource.data)
            || (request.resource.data.semester is string
                && request.resource.data.semester.size() <= 50))
        && isValidOptionalPhotoUrl();
      allow delete: if isOwner(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && (!('description' in request.resource.data)
              || (request.resource.data.description is string
                  && request.resource.data.description.size() <= 2000))
          && isValidPriority(request.resource.data.priority)
          && isValidTaskStatus(request.resource.data.status);
        allow delete: if isOwner(userId);
      }

      // Assignments subcollection
      match /assignments/{assignmentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && (!('description' in request.resource.data)
              || (request.resource.data.description is string
                  && request.resource.data.description.size() <= 2000))
          && isValidPriority(request.resource.data.priority)
          && request.resource.data.isCompleted is bool;
        allow delete: if isOwner(userId);
      }

      // Subjects subcollection
      match /subjects/{subjectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.subjectName is string
          && request.resource.data.subjectName.size() > 0
          && request.resource.data.subjectName.size() <= 120
          && request.resource.data.attendanceThreshold is number
          && request.resource.data.attendanceThreshold >= 0
          && request.resource.data.attendanceThreshold <= 100;
        allow delete: if isOwner(userId);
      }

      // Attendance subcollection
      match /attendance/{attendanceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.isPresent is bool;
        allow delete: if isOwner(userId);
      }

      // Quiz results subcollection
      match /quizResults/{resultId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 100
          && request.resource.data.score is int
          && request.resource.data.totalQuestions is int
          && request.resource.data.score >= 0
          && request.resource.data.totalQuestions > 0
          && request.resource.data.totalQuestions <= 200
          && request.resource.data.score <= request.resource.data.totalQuestions;
        allow delete: if isOwner(userId);
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 50000
          && (!('category' in request.resource.data)
              || (request.resource.data.category is string
                  && request.resource.data.category.size() <= 50))
          && (!('isPinned' in request.resource.data) || request.resource.data.isPinned is bool);
        allow delete: if isOwner(userId);
      }

      // Study sessions subcollection
      match /studySessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes > 0
          && request.resource.data.durationMinutes <= 1440
          && (!('title' in request.resource.data)
              || (request.resource.data.title is string
                  && request.resource.data.title.size() <= 150))
          && (!('isCompleted' in request.resource.data) || request.resource.data.isCompleted is bool);
        allow delete: if isOwner(userId);
      }

      // User preferences / settings
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && (!('themeMode' in request.resource.data)
              || request.resource.data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'])
          && (!('notificationsEnabled' in request.resource.data)
              || request.resource.data.notificationsEnabled is bool)
          && (!('dailyStudyGoalMinutes' in request.resource.data)
              || (request.resource.data.dailyStudyGoalMinutes is int
                  && request.resource.data.dailyStudyGoalMinutes > 0
                  && request.resource.data.dailyStudyGoalMinutes <= 1440));
        allow delete: if isOwner(userId);
      }

      // FCM device tokens
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidOwnerUid(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 512;
        allow delete: if isOwner(userId);
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
